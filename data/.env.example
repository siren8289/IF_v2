# 로컬 셸에서: set -a; source data/.env; set +a
# Python 모듈과 psql 스크립트는 프로세스 환경변수를 읽습니다.
DB_NAME=if_spring
DB_USER=if_user
PGHOST=localhost
PGPORT=5432
PGPASSWORD=change-me
# 선택: 기존 snapshot 경로를 유지할 때 절대 경로로 지정
# IF_EXTERNAL_DATA_DIR=/absolute/path/to/external
# 공공 API 키는 URL 구성 시 사용하며 실제 키는 커밋하지 않습니다.
# PUBLIC_DATA_API_KEY=
